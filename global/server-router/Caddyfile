{
	admin off
}

:8080 {
	bind 127.0.0.1
	encode gzip

	# Reverse proxy preserves the complete request path, including the app
	# prefix. Do not replace these with handle_path blocks.
	@git path /git /git/*
	handle @git {
		# Forgejo is mounted publicly at /git but expects root-relative
		# requests internally. ROOT_URL remains the public /git/ address.
		uri strip_prefix /git
		reverse_proxy 127.0.0.1:3000
	}
	@mealprep path /mealprep /mealprep/*
	handle @mealprep {
		reverse_proxy 127.0.0.1:9100
	}
	@keycase path /keycase /keycase/*
	handle @keycase {
		reverse_proxy 127.0.0.1:8787
	}
	@factory path /factory /factory/*
	handle @factory {
		reverse_proxy 127.0.0.1:3187
	}

	@astrocade path /astrocade-specialist /astrocade-specialist/*
	handle @astrocade {
		# No strip_prefix: the app is built and configured to receive the
		# whole path, prefix included (BASE_PATH=/astrocade-specialist).
		reverse_proxy 127.0.0.1:8801
	}

	# Static app: strip only for filesystem lookup; the public URL remains
	# /neon-labrinth/.
	@neon path /neon-labrinth /neon-labrinth/*
	handle @neon {
		uri strip_prefix /neon-labrinth
		root * /var/www/neon-labrinth/dist
		file_server
	}

	@cozytavern path /cozytavern /cozytavern/*
	handle @cozytavern {
		@noslash path /cozytavern
		redir @noslash /cozytavern/ 308
		uri strip_prefix /cozytavern
		root * /var/www/cozytavern
		file_server
	}

	@happyhour path /happy-hour /happy-hour/*
	handle @happyhour {
		@noslash path /happy-hour
		redir @noslash /happy-hour/ 308
		uri strip_prefix /happy-hour
		root * /var/www/happy-hour
		file_server
	}
	@voicehub path /voicehub /voicehub/*
	handle @voicehub {
		# The app doesn't know its mount path: strip the prefix before
		# proxying, and send it downstream over the redirect first so
		# relative asset links (style.css, app.js) resolve correctly.
		@voicehubnoslash path /voicehub
		redir @voicehubnoslash /voicehub/ 308
		uri strip_prefix /voicehub
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Real-IP {remote_host}
		}
	}
	@simpled path /simpled /simpled/*
	handle @simpled {
		# The page uses relative links, so the prefix is stripped for the app and
		# the bare /simpled is redirected to /simpled/ - that is the first click
		# from the portal tile, and without the slash the links would resolve
		# against the root.
		@simplednoslash path /simpled
		redir @simplednoslash /simpled/ 308
		uri strip_prefix /simpled
		reverse_proxy 127.0.0.1:9200
	}
	@sentry path /sentry /sentry/*
	handle @sentry {
		@sentrynoslash path /sentry
		redir @sentrynoslash /sentry/ 308
		@sentryws header Upgrade *websocket*
		reverse_proxy @sentryws 192.168.1.99:8788
		uri strip_prefix /sentry
		reverse_proxy 192.168.1.99:8787
	}

	@andy path /andy /andy/*
	handle @andy {
		# Live view of the Andy 3.0 bot; the app is built for the /andy prefix, so the
		# path is kept. It exists only while Andy is playing (502 between runs).
		@andynoslash path /andy
		redir @andynoslash /andy/ 308
		reverse_proxy 127.0.0.1:3190
	}

	# The dashboard owns the bare address now (old static portal is
	# preserved at /var/www/portal.bak-*). Private behind Tailscale Serve;
	# no other app is mounted at /.
	handle {
		reverse_proxy 127.0.0.1:8090
	}
}

